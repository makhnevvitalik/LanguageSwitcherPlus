{
  "sourceLanguage": "en",
  "strings": {
    " (Default)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " (По умолчанию)"
          }
        }
      }
    },
    "%.1f s": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f с"
          }
        }
      }
    },
    "%1$@ needs Input Monitoring to detect your global text shortcut. The shortcut is saved. Allow %1$@ in %2$@. If macOS asks, choose Quit & Reopen; the app will reopen and continue with Accessibility.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ требуется доступ к мониторингу ввода, чтобы распознавать глобальное сочетание для работы с текстом. Сочетание сохранено. Разрешите доступ для %1$@ в разделе «%2$@». Если macOS предложит, выберите «Завершить и открыть снова»: приложение перезапустится и продолжит настройку Универсального доступа."
          }
        }
      }
    },
    "%@ can start automatically when you sign in, so keyboard switching is available right away.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ может запускаться автоматически при входе в систему, чтобы переключение раскладки было доступно сразу."
          }
        }
      }
    },
    "%@ is available.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна версия %@."
          }
        }
      }
    },
    "%@ shortcut": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание для «%@»"
          }
        }
      }
    },
    "%@ uses %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» использует %@"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О приложении"
          }
        }
      }
    },
    "About %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О приложении %@"
          }
        }
      }
    },
    "Accessibility access is required.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется доступ к Универсальному доступу."
          }
        }
      }
    },
    "Active inputs": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активные источники ввода"
          }
        }
      }
    },
    "At least two active": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимум два активных"
          }
        }
      }
    },
    "Add %1$@ manually in %2$@:\n\n1. Click +.\n2. Select /Applications/%1$@.app.\n3. Turn the app on.\n\n%3$@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте %1$@ вручную в разделе «%2$@»:\n\n1. Нажмите +.\n2. Выберите /Applications/%1$@.app.\n3. Включите приложение.\n\n%3$@"
          }
        }
      }
    },
    "After allowing access, run the text action again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После предоставления доступа повторите действие с текстом."
          }
        }
      }
    },
    "Allow %1$@ in %2$@, then return to the app. If macOS asks, choose Quit & Reopen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ для %1$@ в разделе «%2$@», затем вернитесь в приложение. Если macOS предложит, выберите «Завершить и открыть снова»."
          }
        }
      }
    },
    "Allow %@ to start at login": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите %@ запускаться при входе"
          }
        }
      }
    },
    "Already assigned to %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже назначено действию «%@»."
          }
        }
      }
    },
    "Apply to": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывать"
          }
        }
      }
    },
    "CC BY-SA 4.0 Legal Code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст лицензии CC BY-SA 4.0"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Capitalize Words": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С прописной буквы"
          }
        }
      }
    },
    "Change case": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить регистр"
          }
        }
      }
    },
    "Change the letter case of selected text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить регистр выделенного текста."
          }
        }
      }
    },
    "Select case": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать регистр"
          }
        }
      }
    },
    "Press and release Command to switch to the next active input source.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и отпустите Command, чтобы переключиться на следующий активный источник ввода."
          }
        }
      }
    },
    "Press and release Fn/Globe to switch to the next active input source. Set the macOS Fn/Globe action to Do Nothing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и отпустите Fn/Globe, чтобы переключиться на следующий активный источник ввода. В macOS выберите для Fn/Globe действие «Ничего не делать»."
          }
        }
      }
    },
    "If text is selected, the action applies to it; otherwise, to all tracked typed text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если текст выделен, действие применяется к нему; иначе — ко всему отслеживаемому набранному тексту."
          }
        }
      }
    },
    "If text is selected, the action applies to it; otherwise, to the most recently tracked word.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если текст выделен, действие применяется к нему; иначе — к последнему отслеживаемому слову."
          }
        }
      }
    },
    "The action applies only to selected text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие применяется только к выделенному тексту."
          }
        }
      }
    },
    "Change…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить…"
          }
        }
      }
    },
    "Check for Updates": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить обновления"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка…"
          }
        }
      }
    },
    "Choose a valid shortcut before saving.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед сохранением задайте допустимое сочетание."
          }
        }
      }
    },
    "Choose a valid shortcut.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте допустимое сочетание."
          }
        }
      }
    },
    "Choose whether to press a shortcut once, repeat the whole shortcut, or hold modifiers and tap the final key twice.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите: нажать сочетание один раз, повторить его целиком или удерживать модификаторы и дважды нажать последнюю клавишу."
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить"
          }
        }
      }
    },
    "Command alone is used by Keyboard switching. Choose different keys.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Command без других клавиш используется для переключения раскладки. Выберите другое сочетание."
          }
        }
      }
    },
    "Command switching conflicts with a text action that uses Command alone. Clear or change that text shortcut first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключение с помощью Command конфликтует с действием, которому назначен Command без других клавиш. Сначала очистите или измените это сочетание."
          }
        }
      }
    },
    "Command switching was turned off.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключение с помощью Command отключено."
